# Server secrets: copy into the ISOLATED Supabase project's secret store, never Vercel VITE_*.
# Do not reuse production credentials. Disabled by default until preflight passes.
PAYMENT_ENV=test
EMAIL_ENV=test
GUMROAD_ENV=test
PAYMENTS_ENABLED=false
GUMROAD_ENABLED=false
PUBLIC_SITE_URL=https://your-protected-staging.vercel.app
TEST_BUYER_EMAILS=replace-with-authorized-test-inbox
MP_ACCESS_TOKEN=TEST-REPLACE
MP_WEBHOOK_SECRET=REPLACE-WITH-TEST-WEBHOOK-SECRET
RESEND_API_KEY=REPLACE-WITH-SCOPED-STAGING-KEY
RESEND_WEBHOOK_SECRET=whsec_REPLACE
GUMROAD_ACCESS_TOKEN=REPLACE-WITH-VIEW-SALES-ONLY-TOKEN
GUMROAD_WEBHOOK_TOKEN=REPLACE-WITH-RANDOM-32-PLUS-CHARACTERS
GUMROAD_SELLER_ID=REPLACE
GUMROAD_KIT_PRODUCT_ID=ISOLATED-TEST-PRODUCT-ID
GUMROAD_PROGRAM_PRODUCT_ID=ISOLATED-TEST-PRODUCT-ID
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY. Do not copy production values.
# Never configure BARK_URL / NTFY_TOPIC in staging.
